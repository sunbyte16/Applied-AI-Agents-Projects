# ==============================================================================
# PromptLab AI - Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit your actual .env file or hardcode API keys in the codebase!
# ==============================================================================

# Primary LLM API Key (OpenAI or OpenAI-compatible provider)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom API Base URL for OpenAI-compatible providers
# Examples:
#   OpenAI Official: https://api.openai.com/v1 (leave empty or default)
#   Groq: https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama (local): http://localhost:11434/v1
#   Google Gemini (OpenAI compat): https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=

# Default Model to use for generation
# Examples: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
DEFAULT_MODEL=gpt-4o-mini

# Server Configuration
HOST=127.0.0.1
PORT=8000
